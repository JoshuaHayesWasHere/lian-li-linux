#!/usr/bin/env bash
# Move the case-console branch onto upstream's newest release, test it, push it, and
# say so. Installing stays a manual `makepkg -si`, since it needs sudo.
set -euo pipefail

repo="$(git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)"
branch=case-console
notify() { notify-send --app-name=lianli-linux-case "$@" || true; echo "$*"; }

git -C "$repo" fetch --quiet --tags upstream
git -C "$repo" fetch --quiet origin "$branch"
latest="$(git -C "$repo" tag -l 'v*' --sort=-v:refname | grep -E '^v[0-9]+(\.[0-9]+)*$' | head -1)"
old="$(git -C "$repo" rev-parse "origin/$branch")"
base="$(git -C "$repo" describe --tags --abbrev=0 --match 'v[0-9]*' "$old")"
[ "$base" = "$latest" ] && exit 0

work="$(mktemp -d)"
trap 'git -C "$repo" worktree remove --force "$work" 2>/dev/null || true; rm -rf "$work"' EXIT
git -C "$repo" worktree add --quiet --detach "$work" "$old"
cd "$work"
if ! git rebase --quiet --onto "$latest" "$base"; then
    git rebase --abort
    notify --urgency=critical "lianli-linux-case: patches conflict with $latest" \
        "Rebase $branch onto $latest by hand in $repo."
    exit 1
fi
git submodule update --quiet --init --recursive --depth=1
if ! CARGO_TARGET_DIR="$repo/target" cargo test --workspace --release --quiet >"$work.log" 2>&1; then
    notify --urgency=critical "lianli-linux-case: tests fail on $latest" "Log: $work.log"
    exit 1
fi
git push --quiet --force-with-lease="$branch:$old" origin "HEAD:$branch"
rm -f "$work.log"
notify "lianli-linux-case moved to $latest" \
    "Install: cd $repo/packaging/archlinux/case-console && makepkg -si"
